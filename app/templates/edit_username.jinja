{% extends "base.jinja" %}

{% block content %}
<form action="" method="post">
    {{ form.hidden_tag() }}
    
    <p>{{form.username.label}}</p>
    <p>{{form.username()}}</p>
    {% for error in form.username.errors %}
    <span style="color:red;">
        <p>--{{ error }}--</p>
    </span>
    {% endfor %}
    <p>{{form.submit()}}</p>
</form>
{% endblock %}