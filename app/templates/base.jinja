<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="{{url_for('static', filename='styles.css')}}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap"
        rel="stylesheet">
    <script src="{{url_for('static',filename='scripts.js')}}"></script>
    <title>{{title}} - Frascos!</title>
</head>

<body>
    <div class="wrapper">
        <nav class="navbar" id="navbar">Frascos
            <a href="{{ url_for('main.index') }}">Home</a>
            <a href="{{ url_for('main.discover') }}">Discover</a>
            {% if current_user.is_anonymous %}
            <a href="{{ url_for('auth.login') }}">Login</a>
            <a href="{{ url_for('auth.register') }}">Register</a>
            {% else %}
            <a href="{{ url_for('main.user',username=current_user.username)}}">Meu perfil</a>
            <a href="{{ url_for('auth.logout') }}">Logout</a>
            {% endif %}
        </nav>


        <aside class="navbar-desktop">
            <ul>
                <li><button><a href="{{ url_for('main.index') }}">Home</a></button></li>
                <li><button><a href="{{ url_for('main.discover') }}">Discover</a></button></li>
                {% if current_user.is_anonymous %}
                <li><button><a href="{{ url_for('auth.login') }}">Login</a></button></li>
                <li><button><a href="{{ url_for('auth.register') }}">Register</a></button></li>
                {% else %}
                <li><button><a href="{{ url_for('main.user',username=current_user.username)}}">Meu perfil</a></button></li>
                <li><button><a href="{{ url_for('auth.logout') }}">Logout</a></button></li>
                {% endif %}
            </ul>
        </aside>
        <section class="content">{% block content %} {% endblock %}</section>
    </div>
</body>

</html>