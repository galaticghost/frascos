{% extends "base.jinja" %}

{% block content %}
{% with messages = get_flashed_messages() %} {#Modificar isso daqui para entrar dentro de uma div#}
{% if messages %}   {#Senão acaba destruindo o grid#}
<ul>
    {% for message in messages %}
    <li>{{ message }}</li>
    {% endfor %}
</ul>
{% endif %}
{% endwith %}
<h1>Sign in</h1>
<form action="" method="post">
    {{ form.hidden_tag() }}
    <p>{{form.username.label}}</p>
    <p>{{form.username(size=30)}}</p>
    {% for error in form.username.errors %}
    <span style="color:red">
        <p>-- {{error}} --</p>
    </span>
    {% endfor %}

    <p>{{form.password.label}}</p>
    <p>{{form.password(size=30)}}</p>
    {% for error in form.password.errors %}
    <span style="color:red">
        <p>-- {{error}} --</p>
    </span>
    {% endfor%}

    <p>{{form.remember_me()}} {{form.remember_me.label}}</p>
    <p>{{form.submit()}}</p>
</form>
{% endblock %}